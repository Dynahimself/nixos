/* Catppuccin Mocha Mauve — Sleek Spotlight-style Rofi (zero beige bleed) */
configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    display-drun:        "";
    display-run:         "";
    display-window:      "";
    drun-display-format: "{name}";
    disable-history:     false;
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
}

* {
    crust:     #11111bff;
    mantle:    #181825ff;
    base:      #1e1e2eff;
    surface0:  #313244ff;
    surface1:  #45475aff;
    overlay0:  #6c7086ff;
    subtext0:  #a6adc8ff;
    text:      #cdd6f4ff;
    mauve:     #cba6f7ff;
    blue:      #89b4faff;
    green:     #a6e3a1ff;
    red:       #f38ba8ff;

    font: "JetBrainsMono Nerd Font 11.5";
    background-color: transparent;
    text-color: @text;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            640px;
    border:           2px solid;
    border-color:     @mauve;
    border-radius:    14px;
    background-color: @base;
    padding:          16px;
}

mainbox {
    spacing:          12px;
    background-color: transparent;
    children:         [ "inputbar", "message", "listview" ];
}

inputbar {
    spacing:          10px;
    padding:          10px 14px;
    border:           1px solid;
    border-color:     @surface0;
    border-radius:    10px;
    background-color: @mantle;
    children:         [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color:       @mauve;
    vertical-align:   0.5;
}

entry {
    background-color:  transparent;
    text-color:        @text;
    placeholder:       "Search…";
    placeholder-color: @overlay0;
    vertical-align:    0.5;
    cursor:            text;
}

message {
    padding:          8px 12px;
    border:           0px;
    border-radius:    8px;
    background-color: @mantle;
}

textbox {
    background-color: transparent;
    text-color:       @subtext0;
}

listview {
    columns:          1;
    lines:            8;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    fixed-height:     false;
    border:           0px;
    spacing:          4px;
    background-color: transparent;
}

element {
    spacing:          12px;
    padding:          9px 12px;
    border:           0px;
    border-radius:    9px;
    background-color: transparent;
    text-color:       @subtext0;
    orientation:      horizontal;
    cursor:           pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @subtext0;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color:       @green;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color:       @red;
}

element selected.normal,
element selected.active {
    background-color: @surface0;
    text-color:       @mauve;
}

element selected.urgent {
    background-color: @red;
    text-color:       @crust;
}

element-icon {
    size:             26px;
    background-color: transparent;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    vertical-align:   0.5;
    text-color:       inherit;
}
