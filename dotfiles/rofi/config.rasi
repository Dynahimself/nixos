configuration {
    modi:                 "drun,window,run";
    show-icons:           true;
    icon-theme:           "Papirus-Dark";
    display-drun:         " Apps";
    display-window:       " Windows";
    display-run:          " Run";
    drun-display-format:  "{name}";
    window-format:        "{w}  ·  {c}  —  {t}";
    disable-history:      false;
    hover-select:         true;
    me-select-entry:      "";
    me-accept-entry:      "MousePrimary";
    kb-row-down:          "Down,Control+e,Control+j";
    kb-row-up:            "Up,Control+i,Control+k";
    kb-move-end:          "";
    kb-remove-to-eol:     "";
    kb-accept-entry:      "Return,KP_Enter";
    kb-mode-next:         "Shift+Right,Control+Tab";
    kb-mode-previous:     "Shift+Left,Control+ISO_Left_Tab";
}

* {
    crust:       #11111bff;
    mantle:      #181825e6;
    base:        #1e1e2ed9;
    surface0:    #313244cc;
    surface1:    #45475aff;
    overlay0:    #6c7086ff;
    subtext0:    #a6adc8ff;
    text:        #cdd6f4ff;
    accent:      #cba6f7ff;
    accent-alt:  #89b4faff;
    green:       #a6e3a1ff;
    red:         #f38ba8ff;

    font: "JetBrainsMono Nerd Font 11.5";
    background-color: transparent;
    text-color: @text;
}

@import "/home/dyna/.cache/mocha-theme/accent.rasi"

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            680px;
    border:           2px solid;
    border-color:     @accent;
    border-radius:    16px;
    background-color: @base;
    padding:          16px;
}

mainbox {
    spacing:          12px;
    background-color: transparent;
    children:         [ "inputbar", "message", "listview", "mode-switcher" ];
}

inputbar {
    spacing:          10px;
    padding:          11px 14px;
    border:           1px solid;
    border-color:     @surface1;
    border-radius:    11px;
    background-color: @mantle;
    children:         [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    vertical-align:   0.5;
}

entry {
    background-color:  transparent;
    text-color:        @text;
    placeholder:       "Type to search… (Ctrl+e/i to move)";
    placeholder-color: @overlay0;
    vertical-align:    0.5;
    cursor:            text;
}

message {
    padding:          8px 12px;
    border:           1px solid;
    border-color:     @surface0;
    border-radius:    9px;
    background-color: @mantle;
}

textbox {
    background-color: transparent;
    text-color:       @subtext0;
}

listview {
    columns:          1;
    lines:            9;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    fixed-height:     false;
    border:           0px;
    spacing:          4px;
    background-color: transparent;
}

element {
    spacing:          12px;
    padding:          9px 12px;
    border:           0px;
    border-radius:    10px;
    background-color: transparent;
    text-color:       @subtext0;
    orientation:      horizontal;
    cursor:           pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @subtext0;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color:       @green;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color:       @red;
}

element selected.normal,
element selected.active {
    background-color: @surface0;
    text-color:       @accent;
}

element selected.urgent {
    background-color: @red;
    text-color:       @crust;
}

element-icon {
    size:             26px;
    background-color: transparent;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    vertical-align:   0.5;
    text-color:       inherit;
}

mode-switcher {
    spacing:          8px;
    background-color: transparent;
}

button {
    padding:          7px 10px;
    border-radius:    9px;
    background-color: @mantle;
    text-color:       @subtext0;
    cursor:           pointer;
}

button selected {
    background-color: @accent;
    text-color:       @crust;
}
