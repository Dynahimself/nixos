{
    "workbench.colorTheme": "Catppuccin Mocha",
    "workbench.iconTheme": "catppuccin-mocha",
    "github.copilot.nextEditSuggestions.enabled": true,

    "editor.fontFamily": "'JetBrainsMono Nerd Font Mono', 'JetBrainsMono NF', 'Cascadia Mono', Consolas, monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 13,
    "editor.lineNumbers": "relative",
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "boundary",
    "editor.stickyScroll.enabled": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,

    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font Mono', 'JetBrainsMono NF', monospace",
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.cursorStyle": "line",

    "vim.leader": "<space>",
    "vim.useSystemClipboard": true,
    "vim.hlsearch": true,
    "vim.incsearch": true,
    "vim.smartRelativeLine": true,
    "vim.handleKeys": {
        "<C-c>": false,
        "<C-v>": false,
        "<C-p>": false,
        "<C-b>": false,
        "<C-k>": false
    },
    "vim.normalModeKeyBindingsNonRecursive": [
        { "before": ["n"], "after": ["h"] },
        { "before": ["e"], "after": ["g", "j"] },
        { "before": ["i"], "after": ["g", "k"] },
        { "before": ["o"], "after": ["l"] },
        { "before": ["l"], "after": ["i"] },
        { "before": ["L"], "after": ["I"] },
        { "before": ["g", "l"], "after": ["g", "i"] },
        { "before": ["h"], "after": ["o"] },
        { "before": ["H"], "after": ["O"] },
        { "before": ["j"], "after": ["e"] },
        { "before": ["J"], "after": ["E"] },
        { "before": ["g", "J"], "after": ["J"] },
        { "before": ["k"], "after": ["n", "z", "z"] },
        { "before": ["K"], "after": ["N", "z", "z"] },
        { "before": ["<C-d>"], "after": ["<C-d>", "z", "z"] },
        { "before": ["<C-u>"], "after": ["<C-u>", "z", "z"] },
        { "before": ["<C-n>"], "after": ["<C-w>", "h"] },
        { "before": ["<C-e>"], "after": ["<C-w>", "j"] },
        { "before": ["<C-i>"], "after": ["<C-w>", "k"] },
        { "before": ["<C-o>"], "after": ["<C-w>", "l"] },
        { "before": ["N"], "commands": ["workbench.action.previousEditor"] },
        { "before": ["O"], "commands": ["workbench.action.nextEditor"] },
        { "before": ["<leader>", "w"], "commands": ["workbench.action.files.save"] },
        { "before": ["<leader>", "b", "d"], "commands": ["workbench.action.closeActiveEditor"] },
        { "before": ["<leader>", "f", "f"], "commands": ["workbench.action.quickOpen"] },
        { "before": ["<leader>", "s", "g"], "commands": ["workbench.action.findInFiles"] },
        { "before": ["<leader>", "c", "a"], "commands": ["editor.action.quickFix"] },
        { "before": ["<leader>", "c", "r"], "commands": ["editor.action.rename"] },
        { "before": ["<leader>", "c", "f"], "commands": ["editor.action.formatDocument"] },
        { "before": ["g", "r"], "commands": ["editor.action.goToReferences"] },
        { "before": ["[", "d"], "commands": ["editor.action.marker.prev"] },
        { "before": ["]", "d"], "commands": ["editor.action.marker.next"] }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        { "before": ["n"], "after": ["h"] },
        { "before": ["e"], "after": ["g", "j"] },
        { "before": ["i"], "after": ["g", "k"] },
        { "before": ["o"], "after": ["l"] },
        { "before": ["l"], "after": ["i"] },
        { "before": ["L"], "after": ["I"] },
        { "before": ["h"], "after": ["o"] },
        { "before": ["H"], "after": ["O"] },
        { "before": ["j"], "after": ["e"] },
        { "before": ["J"], "after": ["E"] },
        { "before": ["k"], "after": ["n"] },
        { "before": ["K"], "after": ["N"] }
    ],
    "vim.operatorPendingModeKeyBindingsNonRecursive": [
        { "before": ["n"], "after": ["h"] },
        { "before": ["e"], "after": ["j"] },
        { "before": ["i"], "after": ["k"] },
        { "before": ["o"], "after": ["l"] },
        { "before": ["l"], "after": ["i"] },
        { "before": ["j"], "after": ["e"] },
        { "before": ["J"], "after": ["E"] },
        { "before": ["k"], "after": ["n"] },
        { "before": ["K"], "after": ["N"] }
    ]
}
