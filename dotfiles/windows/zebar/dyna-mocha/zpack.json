{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.1.1/resources/zpack-schema.json",
  "name": "dyna-mocha",
  "version": "1.0.0",
  "description": "Catppuccin Mocha topbar",
  "tags": ["topbar", "catppuccin", "glazewm"],
  "previewImages": [],
  "repositoryUrl": "",
  "widgets": [
    {
      "name": "topbar",
      "htmlPath": "./index.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "index.html",
        "styles.css",
        "app.js",
        "vendor/zebar.bundle.js"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "cmd",
            "argsRegex": "^/c start \"\" https?://100\\.(68\\.54\\.112|97\\.162\\.110):[0-9]+(/.*)?$"
          },
          {
            "program": "wt",
            "argsRegex": "^.*$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "42px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}
