#!/usr/bin/env bash
set -euo pipefail

exec python3 - "${1:-}" <<'PY'
import calendar
import datetime
import json
import os
import sys

offset_file = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "waybar-clock-offset")


def read_offset():
    try:
        with open(offset_file, "r", encoding="utf-8") as f:
            return int(f.read().strip() or "0")
    except Exception:
        return 0


def write_offset(val):
    with open(offset_file, "w", encoding="utf-8") as f:
        f.write(str(val))


arg = sys.argv[1] if len(sys.argv) > 1 else ""
if arg == "+1":
    write_offset(read_offset() + 1)
    sys.exit(0)
elif arg == "-1":
    write_offset(read_offset() - 1)
    sys.exit(0)
elif arg == "reset":
    try:
        os.remove(offset_file)
    except FileNotFoundError:
        pass
    sys.exit(0)

now = datetime.datetime.now()
offset = read_offset()

total_months = (now.year * 12 + (now.month - 1)) + offset
y, m0 = divmod(total_months, 12)
m = m0 + 1

cal = calendar.Calendar(calendar.SUNDAY)
header = f"{calendar.month_name[m]} {y}".center(20)
lines = [
    f"<span color=\x27#cba6f7\x27><b>{header}</b></span>",
    "<span color=\x27#f9e2af\x27><b>Su Mo Tu We Th Fr Sa</b></span>",
]

for week in cal.monthdayscalendar(y, m):
    cells = []
    for d in week:
        if d == 0:
            cells.append("  ")
        elif y == now.year and m == now.month and d == now.day:
            cells.append(f"<span color=\x27#f38ba8\x27><b><u>{d:2d}</u></b></span>")
        else:
            cells.append(f"<span color=\x27#cdd6f4\x27>{d:2d}</span>")
    lines.append(" ".join(cells))

text = now.strftime(" %a %d %b   %H:%M")
tooltip = "<tt><small>" + "\n".join(lines) + "</small></tt>"
print(json.dumps({"text": text, "tooltip": tooltip}, ensure_ascii=False))
PY
