#!/usr/bin/env bash
set -euo pipefail
STATE="/tmp/dyna-game-mode"

if [ ! -f "$STATE" ]; then
  touch "$STATE"
  hyprctl eval "hl.config({ animations = { enabled = false }, decoration = { rounding = 0, blur = { enabled = false }, shadow = { enabled = false }, glow = { enabled = false } }, general = { gaps_in = 0, gaps_out = 0 } })" >/dev/null 2>&1 || true
  pkill -x hypridle 2>/dev/null || true
  pkill -RTMIN+9 waybar 2>/dev/null || true
  notify-send "Gaming Mode" "ON — zero-overhead compositor + hypridle paused"
else
  rm -f "$STATE"
  hyprctl reload >/dev/null 2>&1 || true
  pgrep -x hypridle >/dev/null || (nohup setsid hypridle >/tmp/hypridle.log 2>&1 </dev/null &)
  pkill -RTMIN+9 waybar 2>/dev/null || true
  notify-send "Gaming Mode" "OFF — Mocha glass visuals & hypridle restored"
fi
