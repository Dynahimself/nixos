#!/usr/bin/env bash
set -euo pipefail

vol_out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || echo "Out: ?")
vol_in=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null || echo "Mic: ?")

sinks=$(wpctl status | awk '
  /├─ Sinks:/ { in_s=1; next }
  in_s && /├─|└─/ { in_s=0 }
  in_s {
    line=$0; sub(/^[^0-9*]*/, "", line)
    if (line ~ /^\*?[[:space:]]*[0-9]+\./) {
      mark = (line ~ /^\*/) ? "✓" : " "
      sub(/^\*[[:space:]]*/, "", line); sub(/^[[:space:]]+/, "", line)
      print "[OUT] " mark " " line
    }
  }
')

sources=$(wpctl status | awk '
  /├─ Sources:/ { in_s=1; next }
  in_s && /├─|└─/ { in_s=0 }
  in_s {
    line=$0; sub(/^[^0-9*]*/, "", line)
    if (line ~ /^\*?[[:space:]]*[0-9]+\./) {
      mark = (line ~ /^\*/) ? "✓" : " "
      sub(/^\*[[:space:]]*/, "", line); sub(/^[[:space:]]+/, "", line)
      print "[MIC] " mark " " line
    }
  }
')

menu="${sinks}
${sources}
󰖁  Toggle Output Mute
󰍬  Toggle Mic Mute
󰕾  Open Volume Mixer (pavucontrol)"

chosen=$(printf '%s\n' "$menu" | awk 'NF' | rofi -dmenu -i -p "󰕾 Audio" -mesg "Out: ${vol_out#Volume: }  ·  Mic: ${vol_in#Volume: }" || true)
[ -z "$chosen" ] && exit 0

case "$chosen" in
  *"Toggle Output Mute"*)
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    notify-send "Audio" "Toggled output mute" ;;
  *"Toggle Mic Mute"*)
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    notify-send "Audio" "Toggled microphone mute" ;;
  *"Open Volume Mixer"*)
    nohup setsid pavucontrol >/dev/null 2>&1 </dev/null & ;;
  \[OUT\]*)
    id=$(printf '%s' "$chosen" | sed -nE 's/^\[OUT\][ ✓]+([0-9]+)\..*/\1/p')
    name=$(printf '%s' "$chosen" | sed -E 's/^\[OUT\][ ✓]+[0-9]+\.[[:space:]]*//; s/[[:space:]]*\[vol:.*\]$//')
    [ -n "$id" ] && wpctl set-default "$id" && notify-send "Audio Output" "Switched to ${name}" ;;
  \[MIC\]*)
    id=$(printf '%s' "$chosen" | sed -nE 's/^\[MIC\][ ✓]+([0-9]+)\..*/\1/p')
    name=$(printf '%s' "$chosen" | sed -E 's/^\[MIC\][ ✓]+[0-9]+\.[[:space:]]*//; s/[[:space:]]*\[vol:.*\]$//')
    [ -n "$id" ] && wpctl set-default "$id" && notify-send "Microphone Input" "Switched to ${name}" ;;
esac
