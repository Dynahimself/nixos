#!/usr/bin/env bash
set -euo pipefail

exec python3 - <<'PY'
import datetime
import json
import os
import shutil
import subprocess

snap_file = os.path.expanduser("~/.cache/cshub/waybar-snapshot.json")

# Bootstrap local cache if missing
if not os.path.exists(snap_file) and shutil.which("cshub"):
    subprocess.run(["cshub", "sync", "--quiet"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)

snap = None
try:
    if os.path.exists(snap_file):
        with open(snap_file, "r", encoding="utf-8") as f:
            snap = json.load(f)
except Exception:
    snap = None

if not snap:
    print(json.dumps({"text": "󰑴 Hub", "tooltip": "CS Hub cache not initialized\nClick to open CS Hub menu", "class": "normal"}))
    raise SystemExit(0)

def esc(s):
    return str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

today = datetime.date.today()
open_items = snap.get("open_items") or []
due_terms = int(snap.get("due_terms") or 0)
streak = int(snap.get("streak") or 0)
today_min = int(snap.get("today_minutes") or 0)
online = bool(snap.get("online"))
dirty = int(snap.get("dirty_count") or 0)

# Recompute days_left live (in case midnight passed since snapshot)
for it in open_items:
    dd = it.get("due_date") or ""
    if dd:
        try:
            it["days_left"] = (datetime.date.fromisoformat(dd[:10]) - today).days
        except Exception:
            it["days_left"] = None
    else:
        it["days_left"] = None

overdue = [i for i in open_items if i["days_left"] is not None and i["days_left"] < 0]
exams = [i for i in open_items if i.get("kind") == "exam" and i["days_left"] is not None and i["days_left"] >= 0]
deadlines = [i for i in open_items if i.get("kind") in ("homework", "deadline", "lab", "project") and i["days_left"] is not None and i["days_left"] >= 0]

cls = "normal"
if overdue:
    cls = "urgent"
    text = f"󰑴 {len(overdue)} LATE · {len(open_items)} open"
elif exams and exams[0]["days_left"] <= 7:
    ex = exams[0]
    d = ex["days_left"]
    cls = "urgent" if d <= 2 else "soon"
    when = "TODAY" if d == 0 else ("TMR" if d == 1 else f"{d}d")
    title = (ex.get("title") or "")[:16]
    text = f"󰑴 {when}: {title}"
elif deadlines and deadlines[0]["days_left"] <= 3:
    dl = deadlines[0]
    d = dl["days_left"]
    cls = "urgent" if d == 0 else "soon"
    when = "TODAY" if d == 0 else ("TMR" if d == 1 else f"{d}d")
    title = (dl.get("title") or "")[:16]
    text = f"󰑴 {when}: {title}"
elif open_items or due_terms:
    parts = []
    if open_items:
        parts.append(f"{len(open_items)} todo")
    if due_terms:
        parts.append(f"{due_terms} due")
    text = "󰑴 " + " · ".join(parts)
else:
    text = "󰑴 Clear ✓"

lines = [f"<span color='#cba6f7'><b>CS Student Hub</b></span>  <span color='#a6adc8'>🔥{streak}d · {today_min}m today · {due_terms} cards due</span>"]

if overdue:
    lines.append("")
    lines.append(f"<span color='#f38ba8'><b> OVERDUE ({len(overdue)})</b></span>")
    for it in overdue[:4]:
        c = f" [{esc(it['course'])}]" if it.get("course") else ""
        lines.append(f"  <span color='#f38ba8'>● {abs(it['days_left'])}d late</span> {esc(it['title'][:28])}<span color='#b4befe'>{c}</span>")

upcoming = [i for i in open_items if i not in overdue][:7]
if upcoming:
    lines.append("")
    lines.append("<span color='#fab387'><b>Upcoming</b></span>")
    kcol = {"exam": "#f38ba8", "homework": "#fab387", "deadline": "#fab387", "lab": "#f9e2af", "project": "#cba6f7", "task": "#94e2d5"}
    ktag = {"exam": "EXAM", "homework": "HW", "deadline": "DUE", "lab": "LAB", "project": "PROJ", "task": "TASK"}
    for it in upcoming:
        k = it.get("kind", "task")
        d = it["days_left"]
        when = "no date" if d is None else ("TODAY" if d == 0 else ("TMR" if d == 1 else f"in {d}d ({it['due_date'][5:]})"))
        c = f" [{esc(it['course'])}]" if it.get("course") else ""
        w = f" {it['weight']:g}%" if it.get("weight") else ""
        lines.append(f"  <span color='{kcol.get(k,'#cdd6f4')}'>{ktag.get(k,'ITEM'):<4}</span> {esc(it['title'][:26])}<span color='#b4befe'>{c}</span><span color='#f5c2e7'>{w}</span>  <span color='#a6adc8'>{when}</span>")
elif not overdue:
    lines.append("")
    lines.append("<span color='#a6e3a1'>✓ All caught up — no open exams or tasks</span>")

sync_s = "<span color='#a6e3a1'>● Pi synced</span>" if online else f"<span color='#f9e2af'>⚡ Offline cache ({dirty} queued)</span>"
lines.append("")
lines.append(f"{sync_s}")
lines.append("<span color='#6c7086'>Left: Menu · Middle: Terminal Dash · Right: Web UI</span>")

print(json.dumps({"text": text, "tooltip": "\n".join(lines), "class": cls}, ensure_ascii=False))
PY
