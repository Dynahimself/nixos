#!/usr/bin/env bash
set -euo pipefail

entries=$(cliphist list || true)
thumb_dir="${XDG_RUNTIME_DIR:-/tmp}/cliphist-thumbs"
mkdir -p "$thumb_dir"

fleet_meta=$(python3 - <<'PY'
import json, urllib.request
try:
    with urllib.request.urlopen("http://100.68.54.112:8210/api/clip", timeout=1.2) as r:
        d = json.loads(r.read().decode("utf-8"))
    txt = (d.get("text") or "").replace("\n", " ").strip()
    if txt:
        print(f"{d.get('source','?')}: {txt[:42]}")
except Exception:
    pass
PY
)

chosen=$(python3 - "$thumb_dir" "$entries" "$fleet_meta" <<'PY'
import os, re, subprocess, sys

thumb_dir, raw, fmeta = sys.argv[1], sys.argv[2], sys.argv[3].strip()
lines = [l for l in raw.splitlines() if l.strip()]

rofi_in = ["󰅌  Push Clipboard -> Fleet (Desktop / Laptop / Win)"]
if fmeta:
    rofi_in.append(f"󰅍  Pull Fleet Clipboard  [{fmeta}]")
else:
    rofi_in.append("󰅍  Pull Fleet Clipboard  [empty]")

if lines:
    rofi_in.append("󰆴  Clear Clipboard History")

for l in lines[:80]:
    m = re.match(r"^(\d+)\t\[\[\s*binary data.*?(png|jpg|jpeg|webp|bmp)", l, re.I)
    if m:
        cid, ext = m.group(1), m.group(2).lower()
        tpath = os.path.join(thumb_dir, f"{cid}.{ext}")
        if not os.path.exists(tpath):
            try:
                data = subprocess.check_output(["cliphist", "decode"], input=l.encode(), timeout=2)
                with open(tpath, "wb") as f:
                    f.write(data)
            except Exception:
                tpath = ""
        if tpath:
            rofi_in.append(f"{l}\0icon\x1f{tpath}")
            continue
    rofi_in.append(l)

p = subprocess.run(
    ["rofi", "-dmenu", "-show-icons", "-i", "-p", "󰅌 Clipboard",
     "-mesg", "Select to copy · Push/Pull syncs across Desktop, Laptop, Win & Phone"],
    input="\n".join(rofi_in),
    text=True,
    capture_output=True,
)
print(p.stdout.strip())
PY
)

[ -z "$chosen" ] && exit 0

case "$chosen" in
  "󰅌  Push Clipboard -> Fleet"*)
    fleet-clip push || true
    ;;
  "󰅍  Pull Fleet Clipboard"*)
    fleet-clip pull || true
    ;;
  "󰆴  Clear Clipboard History")
    cliphist wipe
    rm -rf "$thumb_dir"
    notify-send "Clipboard" "Cleared clipboard history"
    ;;
  *)
    printf '%s' "$chosen" | cliphist decode | wl-copy
    notify-send "Clipboard" "Copied selection to clipboard"
    ;;
esac
