#!/usr/bin/env bash
set -euo pipefail

st_study=$([ -f /tmp/dyna-study-mode ] && echo "[ON]" || echo "[OFF]")
st_game=$([ -f /tmp/dyna-game-mode ] && echo "[ON]" || echo "[OFF]")
st_night=$(pgrep -x hyprsunset >/dev/null 2>&1 && echo "[ON 4200K]" || echo "[OFF]")
st_rec=$(pgrep -x wf-recorder >/dev/null 2>&1 && echo "[REC]" || echo "[OFF]")
st_pomo=$([ -f "${XDG_RUNTIME_DIR:-/tmp}/waybar-pomo-end" ] && echo "[ACTIVE]" || echo "[OFF]")
st_kb=$(hyprctl getoption input:kb_variant 2>/dev/null | grep -q colemak_dh && echo "[Colemak-DH]" || echo "[QWERTY]")
st_ffm=$([ "$(hyprctl getoption input:follow_mouse -j 2>/dev/null | jq -r .int)" = "1" ] && echo "[ON]" || echo "[OFF]")
cur_acc=$(jq -r '"\(.name) (\(.primary))"' "$HOME/.cache/mocha-theme/accent.json" 2>/dev/null || echo "Mauve")

choice=$(printf '%s\n' \
  "󰉋  Desktop Workbench & Project Hub (SUPER+D)" \
  "󰏘  Catppuccin Accent Switcher [${cur_acc}]" \
  "󰸉  Auto-Match Accent to Current Wallpaper" \
  "󰸉  Wallpaper Switcher (SUPER+SHIFT+W)" \
  "󰔟  Pomodoro 25m Focus Timer ${st_pomo}" \
  "󰑴  Study Mode Toggle ${st_study} (SUPER+F1)" \
  "󰊴  Gaming Mode Toggle ${st_game} (SUPER+F2)" \
  "󰖔  Night Light Toggle ${st_night}" \
  "󰕾  Audio & Mic Switcher (SUPER+O)" \
  "󰃬  Calculator (SUPER+C)" \
  "󰅌  Clipboard History (SUPER+V)" \
  "󰖩  Network & Tailscale Manager (SUPER+W)" \
  "󰂯  Bluetooth Manager" \
  "󰕾  Audio Mixer (pavucontrol)" \
  "󰄀  Screenshot Region -> Annotate (SUPER+SHIFT+S)" \
  "󰄀  Screenshot Window" \
  "󰄀  Screenshot Fullscreen" \
  "󰈋  Color Picker -> Clipboard (SUPER+SHIFT+C)" \
  "󰈬  OCR Region eng+fra -> Clipboard (SUPER+SHIFT+O)" \
  "󰑊  Screen Recording MP4 ${st_rec} (SUPER+SHIFT+R)" \
  "󰌌  Keyboard Layout ${st_kb} (SUPER+G)" \
  "󰍽  Focus-Follows-Mouse ${st_ffm}" \
  "󰑓  Reload Hyprland & Waybar" \
  "󰌌  Command Palette & Keybinds (SUPER+/)" | rofi -dmenu -i -p "⚙ System" -mesg "Accent: ${cur_acc}  ·  KB: ${st_kb}  ·  Study: ${st_study}  ·  Game: ${st_game}" || true)

[ -z "$choice" ] && exit 0
case "$choice" in
  *"Desktop Workbench"*) rofi-workbench ;;
  *"Accent Switcher"*) theme-accent ;;
  *"Auto-Match Accent"*) theme-accent --auto ;;
  *"Wallpaper Switcher"*) rofi-wallpaper ;;
  *"Pomodoro"*) clock-bar pomo && pkill -RTMIN+8 waybar 2>/dev/null || true ;;
  *"Study Mode"*) study-mode ;;
  *"Gaming Mode"*) game-mode ;;
  *"Night Light"*)
    if pkill -x hyprsunset 2>/dev/null; then
      notify-send "Night Light" "Disabled"
    else
      if command -v hyprsunset >/dev/null; then
        nohup setsid hyprsunset -t 4200 >/dev/null 2>&1 </dev/null &
        notify-send "Night Light" "Enabled (4200K)"
      else
        notify-send -u critical "Night Light" "hyprsunset not installed"
      fi
    fi
    pkill -RTMIN+9 waybar 2>/dev/null || true ;;
  *"Audio & Mic"*) rofi-audio ;;
  *"Calculator"*) rofi-calc ;;
  *"Clipboard History"*) rofi-clip ;;
  *"Network & Tailscale"*) rofi-wifi ;;
  *"Bluetooth Manager"*) nohup setsid blueman-manager >/dev/null 2>&1 </dev/null & ;;
  *"Audio Mixer"*) nohup setsid pavucontrol >/dev/null 2>&1 </dev/null & ;;
  *"Screenshot Region"*)
    if command -v satty >/dev/null && command -v grim >/dev/null && command -v slurp >/dev/null; then
      geom=$(slurp 2>/dev/null) || exit 0; [ -z "$geom" ] && exit 0; grim -g "$geom" - | satty -f -
    else
      hyprshot -m region
    fi ;;
  *"Screenshot Window"*) hyprshot -m window ;;
  *"Screenshot Fullscreen"*) hyprshot -m output ;;
  *"Color Picker"*)
    if command -v hyprpicker >/dev/null; then
      c=$(hyprpicker -a -n || true)
      [ -n "$c" ] && notify-send "Color Picker" "Copied ${c} to clipboard"
    else
      notify-send -u critical "Color Picker" "hyprpicker needs NixOS rebuild"
    fi ;;
  *"OCR Region"*)
    if command -v tesseract >/dev/null && command -v grim >/dev/null && command -v slurp >/dev/null; then
      geom=$(slurp 2>/dev/null) || exit 0; [ -z "$geom" ] && exit 0; txt=$(grim -g "$geom" - | tesseract - - -l eng+fra 2>/dev/null || true)
      [ -n "$txt" ] && printf '%s' "$txt" | wl-copy && notify-send "OCR Copied" "$(printf '%s' "$txt" | head -c 100)"
    else
      notify-send -u critical "OCR" "tesseract/grim/slurp missing"
    fi ;;
  *"Screen Recording"*)
    if pgrep -x wf-recorder >/dev/null; then
      pkill -INT -x wf-recorder
      notify-send "Recorder" "Saved to ~/Videos/"
    else
      if command -v wf-recorder >/dev/null && command -v slurp >/dev/null; then
        mkdir -p "$HOME/Videos"
        f="$HOME/Videos/rec_$(date +%Y%m%d_%H%M%S).mp4"
        geom=$(slurp 2>/dev/null) || exit 0; [ -z "$geom" ] && exit 0; nohup setsid wf-recorder -g "$geom" -f "$f" >/dev/null 2>&1 </dev/null &
        notify-send "Recorder" "Recording started -> $f"
      else
        notify-send -u critical "Recorder" "wf-recorder/slurp missing"
      fi
    fi ;;
  *"Keyboard Layout"*)
    hyprctl eval 'require("automation").toggle_colemak()' >/dev/null 2>&1 || true ;;
  *"Focus-Follows-Mouse"*)
    cur=$(hyprctl getoption input:follow_mouse -j | jq .int)
    if [ "$cur" = "1" ]; then
      hyprctl eval 'hl.config({ input = { follow_mouse = 0 } })' >/dev/null
      notify-send "Hyprland" "Focus follows mouse: OFF"
    else
      hyprctl eval 'hl.config({ input = { follow_mouse = 1 } })' >/dev/null
      notify-send "Hyprland" "Focus follows mouse: ON"
    fi ;;
  *"Reload Hyprland"*)
    hyprctl reload >/dev/null 2>&1 || true
    pkill -x waybar 2>/dev/null || true
    pkill -x .waybar-wrapped 2>/dev/null || true
    sleep 0.15
    nohup setsid waybar >/tmp/waybar.log 2>&1 </dev/null &
    swaync-client -rs >/dev/null 2>&1 || true
    notify-send "Desktop" "Reloaded Hyprland, Waybar & SwayNC" ;;
  *"Command Palette"*) rofi-binds ;;
esac
