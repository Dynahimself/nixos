#!/usr/bin/env bash
set -euo pipefail
cap=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1 || true)
stat=$(cat /sys/class/power_supply/BAT*/status 2>/dev/null | head -n1 || true)
[ -z "$cap" ] || [ "$stat" != "Discharging" ] && { rm -f /tmp/bat-warn-20 /tmp/bat-warn-10; exit 0; }

if [ "$cap" -le 10 ] && [ ! -f /tmp/bat-warn-10 ]; then
  touch /tmp/bat-warn-10
  notify-send -u critical "Battery Critical (${cap}%)" "Plug in charger immediately"
elif [ "$cap" -le 20 ] && [ ! -f /tmp/bat-warn-20 ]; then
  touch /tmp/bat-warn-20
  notify-send -u normal "Battery Low (${cap}%)" "Consider plugging in"
fi
