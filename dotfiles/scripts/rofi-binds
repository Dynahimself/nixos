#!/usr/bin/env bash
set -euo pipefail
{
  if [ -f /etc/nixos/dotfiles/hypr/conf/binds.conf ]; then
    awk -F',' '
      /^[[:space:]]*bind/ {
        gsub(/^[[:space:]]*bind[a-z]*[[:space:]]*=[[:space:]]*/, "", $1);
        gsub(/\$mainMod/, "SUPER", $1);
        key = $1 " + " $2;
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", key);
        cmd = "";
        for (i = 3; i <= NF; i++) cmd = cmd (i > 3 ? "," : "") $i;
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", cmd);
        printf "%-26s -> %s\n", key, cmd;
      }
    ' /etc/nixos/dotfiles/hypr/conf/binds.conf
  fi
  if [ -f "$HOME/cheatsheet.txt" ]; then
    echo "--- ~/cheatsheet.txt ---"
    cat "$HOME/cheatsheet.txt"
  fi
} | rofi -dmenu -i -p "󰌌 Keybinds" >/dev/null || true
