#!/usr/bin/env bash
set -euo pipefail
dirs=("$HOME/backgrounds")
[ -d "$HOME/Pictures/Wallpapers" ] && dirs+=("$HOME/Pictures/Wallpapers")
mapfile -t imgs < <(find -L "${dirs[@]}" -maxdepth 2 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | sort)
if [ ${#imgs[@]} -eq 0 ]; then
  notify-send "Wallpaper" "No images found in ~/backgrounds/"
  exit 0
fi

cur="none"
[ -e "$HOME/.cache/current-wallpaper" ] && cur=$(basename "$(readlink -f "$HOME/.cache/current-wallpaper" 2>/dev/null || echo "$HOME/.cache/current-wallpaper")")

chosen=$(
  {
    printf '%s\n' "  Random Wallpaper"
    printf '%s\n' "󰏘  Auto-Match Mocha Accent to Current Wallpaper"
    for f in "${imgs[@]}"; do
      printf '%s\0icon\x1f%s\n' "$(basename "$f")" "$f"
    done
  } | rofi -dmenu -show-icons -i -p "󰸉 Wallpaper" -mesg "Current: ${cur}" \
      -theme-str 'element-icon { size: 56px; } listview { lines: 6; }' || true
)

[ -z "$chosen" ] && exit 0

if [ "$chosen" = "󰏘  Auto-Match Mocha Accent to Current Wallpaper" ]; then
  theme-accent --auto
  exit 0
fi

full=""
if [ "$chosen" = "  Random Wallpaper" ]; then
  idx=$(( RANDOM % ${#imgs[@]} ))
  full="${imgs[$idx]}"
  chosen=$(basename "$full")
else
  for f in "${imgs[@]}"; do
    [ "$(basename "$f")" = "$chosen" ] && full="$f" && break
  done
fi
[ -z "$full" ] && exit 0

mkdir -p "$HOME/.cache"
ln -sf "$full" "$HOME/.cache/current-wallpaper"
if command -v awww >/dev/null; then
  pgrep -x awww-daemon >/dev/null || (nohup setsid awww-daemon >/dev/null 2>&1 </dev/null & sleep 0.4)
  awww img "$full" --transition-type grow --transition-duration 0.7 --transition-fps 144
else
  hyprctl hyprpaper preload "$full" >/dev/null 2>&1 || true
  hyprctl hyprpaper wallpaper ",$full" >/dev/null 2>&1 || true
fi
notify-send "Wallpaper" "Applied ${chosen} (synced to hyprlock)"
